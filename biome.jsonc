{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "files": {
    "includes": [
      "**",
      "!data/trials",
      "!data/plain",
      "!data/snapshot",
      "!data/geo",
      "!evals/results/search",
      "!evals/results/facts",
      "!evals/results/questions",
      "!evals/results/check",
      "!evals/results/benchmark",
      "!data/facts/2026-10",
      "!data/criteria",
      "!tests/**/fixtures",
      "!dist",
      "!e2e/.out",
      // A copy of the Claude Design canvas, kept as the canvas wrote it so it can be compared with it.
      "!work/*/design",
      "!local"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        // Off deliberately. This project navigates untyped registry JSON by
        // string key, which is what bracket access is for; the rule's advice
        // suits typed objects. Left on it produced 39 standing infos, and a
        // lint output nobody reads is worse than a rule nobody applies.
        "useLiteralKeys": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
