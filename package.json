{
  "name": "clinical-trial-finder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local proof of concept: an agent that helps a person with cancer find clinical trials worth asking their oncologist about, by asking them questions.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "app": "vite build && node --env-file-if-exists=.env --import tsx scripts/app.ts",
    "fetch:trials": "tsx scripts/fetch-trials.ts",
    "snapshot:fetch": "tsx scripts/fetch-snapshot.ts",
    "geo:fetch": "tsx scripts/fetch-zips.ts",
    "search": "node --import tsx scripts/search.ts",
    "search:sample": "node --import tsx scripts/search-sample.ts",
    "search:show": "node --import tsx scripts/search-show.ts",
    "search:eval": "node --import tsx scripts/search-eval.ts",
    "other:sample": "node --import tsx scripts/other-sample.ts",
    "other:eval": "node --import tsx scripts/other-eval.ts",
    "facts:topics": "node --import tsx scripts/facts-topics.ts",
    "facts:sample": "node --import tsx scripts/facts-sample.ts",
    "facts:label-show": "node --import tsx scripts/facts-label-show.ts",
    "facts:eval": "node --import tsx scripts/facts-eval.ts",
    "facts:map": "node --env-file-if-exists=.env --import tsx scripts/facts-map.ts",
    "facts:show": "node --import tsx scripts/facts-show.ts",
    "facts:try": "node --import tsx scripts/facts-try.ts",
    "questions:split": "node --import tsx scripts/questions-split.ts",
    "questions:eval": "node --import tsx scripts/questions-eval.ts",
    "questions:try": "node --import tsx scripts/questions-try.ts",
    "questions:read": "node --env-file-if-exists=.env --import tsx scripts/questions-read.ts",
    "label:criteria": "node --import tsx scripts/label-criteria.ts",
    "check:label-show": "node --import tsx scripts/check-label-show.ts",
    "check:parse": "node --env-file-if-exists=.env --import tsx scripts/check-parse.ts",
    "check:eval": "node --env-file-if-exists=.env --import tsx scripts/check-eval.ts",
    "benchmark:import": "node --import tsx scripts/benchmark-import.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
